# Copy to `.env.local` and fill in for development services.
# Without a Convex URL the homepage shows a sample wall; backend actions need
# the services and secrets below.

# Convex — from `bunx convex dev` (provisions/syncs a development deployment).
# NEXT_PUBLIC_CONVEX_URL selects the live wall instead of sample archives.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# UploadThing — from the UploadThing dashboard (App settings → API keys).
# Set the same project token in Next AND Convex for durable cleanup retries.
UPLOADTHING_TOKEN=

# Reaction anti-abuse — server-trusted anonymous sessions.
# REACTION_SESSION_SECRET signs the httpOnly session cookie (Next side). Generate
# with: openssl rand -base64 32
# CONVEX_REACTION_SECRET is a shared secret gating the internal reaction write so
# only the /api/react route (not a forged browser call) can move the count. Set
# the SAME value in the Convex dashboard (Settings → Environment Variables).
REACTION_SESSION_SECRET=
CONVEX_REACTION_SECRET=

# Owner moderation (/admin) — the site has no auth provider; access is one
# password.
# ADMIN_PASSWORD: the owner login. Pick something long. (Next side.)
# ADMIN_SESSION_SECRET: signs the httpOnly admin cookie. Separate from the
#   reaction secret so their blast radii don't overlap. Rotating it instantly
#   logs out all admin sessions. Generate with: openssl rand -base64 32 (Next side.)
# CONVEX_ADMIN_SECRET: shared secret gating the owner-only Convex moderation
#   functions (listOpen / moderateRemove / dismissForArchive). Set the SAME value
#   in the Convex dashboard (Settings → Environment Variables), NOT just on Vercel.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CONVEX_ADMIN_SECRET=
